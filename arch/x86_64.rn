(inst push_r64   (enc REX(W=1 B=$rs) 0x50+rs)                           (pattern (push  (reg64 $rs))))
(inst pop_r64    (enc REX(W=1 B=$rd) 0x58+rd)                           (pattern (pop   (reg64 $rd))))
(inst add_rr64   (enc REX(W=1 R=$rs B=$rd) 0x01 ModRM(r $rs rm $rd))   (pattern (add   (reg64 $rd) (reg64 $rs))))
(inst add_ri32   (enc REX(W=1 B=$rd) 0x81 /0 /imm32)                    (pattern (add   (reg64 $rd) (imm32 $imm))))
(inst add_ri8    (enc REX(W=1 B=$rd) 0x83 /0 /imm8)                     (pattern (add   (reg64 $rd) (imm8  $imm))))
(inst sub_rr64   (enc REX(W=1 R=$rs B=$rd) 0x29 ModRM(r $rs rm $rd))   (pattern (sub   (reg64 $rd) (reg64 $rs))))
(inst sub_ri32   (enc REX(W=1 B=$rd) 0x81 /5 /imm32)                    (pattern (sub   (reg64 $rd) (imm32 $imm))))
(inst sub_ri8    (enc REX(W=1 B=$rd) 0x83 /5 /imm8)                     (pattern (sub   (reg64 $rd) (imm8  $imm))))
(inst imul_rr64  (enc REX(W=1 R=$rd B=$rs) 0x0F 0xAF ModRM(r $rd rm $rs)) (pattern (imul (reg64 $rd) (reg64 $rs))))
(inst idiv_r64   (enc REX(W=1 B=$rs) 0xF7 /7)                           (pattern (idiv  (reg64 $rs))))
(inst udiv_r64   (enc REX(W=1 B=$rs) 0xF7 /6)                           (pattern (udiv  (reg64 $rs))))
(inst neg_r64    (enc REX(W=1 B=$rd) 0xF7 /3)                           (pattern (neg   (reg64 $rd))))
(inst inc_r64    (enc REX(W=1 B=$rd) 0xFF /0)                           (pattern (inc   (reg64 $rd))))
(inst dec_r64    (enc REX(W=1 B=$rd) 0xFF /1)                           (pattern (dec   (reg64 $rd))))
(inst and_rr64   (enc REX(W=1 R=$rs B=$rd) 0x21 ModRM(r $rs rm $rd))   (pattern (and   (reg64 $rd) (reg64 $rs))))
(inst and_ri32   (enc REX(W=1 B=$rd) 0x81 /4 /imm32)                    (pattern (and   (reg64 $rd) (imm32 $imm))))
(inst and_ri8    (enc REX(W=1 B=$rd) 0x83 /4 /imm8)                     (pattern (and   (reg64 $rd) (imm8  $imm))))
(inst or_rr64    (enc REX(W=1 R=$rs B=$rd) 0x09 ModRM(r $rs rm $rd))   (pattern (or    (reg64 $rd) (reg64 $rs))))
(inst or_ri32    (enc REX(W=1 B=$rd) 0x81 /1 /imm32)                    (pattern (or    (reg64 $rd) (imm32 $imm))))
(inst or_ri8     (enc REX(W=1 B=$rd) 0x83 /1 /imm8)                     (pattern (or    (reg64 $rd) (imm8  $imm))))
(inst xor_rr64   (enc REX(W=1 R=$rs B=$rd) 0x31 ModRM(r $rs rm $rd))   (pattern (xor   (reg64 $rd) (reg64 $rs))))
(inst xor_ri32   (enc REX(W=1 B=$rd) 0x81 /6 /imm32)                    (pattern (xor   (reg64 $rd) (imm32 $imm))))
(inst xor_ri8    (enc REX(W=1 B=$rd) 0x83 /6 /imm8)                     (pattern (xor   (reg64 $rd) (imm8  $imm))))
(inst not_r64    (enc REX(W=1 B=$rd) 0xF7 /2)                           (pattern (not   (reg64 $rd))))
(inst shl_ri8    (enc REX(W=1 B=$rd) 0xC1 /4 /imm8)                     (pattern (shl   (reg64 $rd) (imm8  $imm))))
(inst shr_ri8    (enc REX(W=1 B=$rd) 0xC1 /5 /imm8)                     (pattern (shr   (reg64 $rd) (imm8  $imm))))
