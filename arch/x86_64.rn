(inst cmp_ri8    (enc REX(W=1 B=$rd) 0x83 /7 /imm8)                     (pattern (cmp   (reg64 $rd) (imm8  $imm))))
(inst test_rr64  (enc REX(W=1 R=$rs B=$rd) 0x85 ModRM(r $rs rm $rd))   (pattern (test  (reg64 $rd) (reg64 $rs))))
(inst test_ri32  (enc REX(W=1 B=$rd) 0xF7 /0 /imm32)                    (pattern (test  (reg64 $rd) (imm32 $imm))))
(inst jmp_r64    (enc REX(W=1 B=$rs) 0xFF /4)                           (pattern (jmp   (reg64 $rs))))
(inst jmp_rel32  (enc 0xE9 /imm32)                                       (pattern (jmp   (imm32 $imm))))
(inst call_r64   (enc REX(W=1 B=$rs) 0xFF /2)                           (pattern (call  (reg64 $rs))))
(inst call_rel32 (enc 0xE9 /imm32)                                       (pattern (call  (imm32 $imm))))
(inst ret        (enc 0xC3)                                              (pattern (ret)))
(inst nop        (enc 0x90)                                              (pattern (nop)))
(inst ud2        (enc 0x0F 0x0B)                                         (pattern (ud2)))