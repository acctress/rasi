(type i64   (primitive))
(type Value (opaque))
(type void  (opaque))

(decl extractor iconst (i64)         Value)
(decl extractor iadd   (Value Value) Value)
(decl extractor isub   (Value Value) Value)
(decl extractor imul   (Value Value) Value)
(decl extractor ret    (Value)       void)

(decl constructor lower_iconst (i64)       Value)
(decl constructor lower_iadd (Value Value) Value)
(decl constructor lower_isub (Value Value) Value)
(decl constructor lower_imul (Value Value) Value)
(decl constructor lower_ret  (Value)       void)

(rule 100 (iconst imm)   (lower_iconst   imm))
(rule 100 (iadd lhs rhs) (lower_iadd lhs rhs))
(rule 100 (isub lhs rhs) (lower_isub lhs rhs))
(rule 100 (imul lhs rhs) (lower_imul lhs rhs))
(rule 100 (ret val)      (lower_ret      val))