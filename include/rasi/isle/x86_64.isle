(type Value (primitive))

(decl extractor iadd (Value Value) Value)
(decl extractor isub (Value Value) Value)
(decl extractor imul (Value Value) Value)
(decl extractor ret  (Value) Value)

(decl constructor emit_iadd (Value Value) Value)
(decl constructor emit_isub (Value Value) Value)
(decl constructor emit_imul (Value Value) Value)
(decl constructor emit_ret  (Value) Value)

(rule 100 (iadd lhs rhs) (emit_iadd lhs rhs))
(rule 100 (isub lhs rhs) (emit_isub lhs rhs))
(rule 100 (imul lhs rhs) (emit_imul lhs rhs))
(rule 100 (ret val)      (emit_ret val))